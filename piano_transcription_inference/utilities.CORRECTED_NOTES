def _librosa_buf_to_float(frame, dtype):
    """Compatibility wrapper for librosa buffer conversion across versions."""
    try:
        return librosa.util.buf_to_float(frame, dtype=dtype)
    except AttributeError:
        return librosa.core.audio.util.buf_to_float(frame, dtype=dtype)


def _librosa_to_mono(y):
    """Compatibility wrapper for librosa mono conversion across versions."""
    try:
        return librosa.to_mono(y)
    except AttributeError:
        return librosa.core.audio.to_mono(y)


def _librosa_resample(y, orig_sr, target_sr, res_type='kaiser_best'):
    """Compatibility wrapper for librosa resampling across versions."""
    try:
        return librosa.resample(y, orig_sr=orig_sr, target_sr=target_sr, res_type=res_type)
    except TypeError:
        return librosa.resample(y, orig_sr, target_sr, res_type=res_type)
    except AttributeError:
        return librosa.core.audio.resample(y, orig_sr, target_sr, res_type=res_type)


def create_folder(fd):
